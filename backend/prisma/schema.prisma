generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
    //pinned to prisma 6 from 7 bcos of that env arguemnt needed for the docker to validate it..If not then we can completely comment it out
    // NOTE :::: if u r running it in the localhost (means not via Dockerfile or compose) then comment this below line ,
   url = env("DATABASE_URL")
}

model User {
  id        Int     @id @default(autoincrement())
  name      String?
  email     String  @unique
  is_active Boolean @default(true)
}